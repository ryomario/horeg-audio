{
  "name": "horeg-audio",
  "version": "1.1.6",
  "description": "Standalone Vanilla TypeScript audio player library with encapsulated Shadow DOM and sound horeg aesthetics.",
  "author": "Mario <ardamomo3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryomario/horeg-audio.git"
  },
  "bugs": {
    "url": "https://github.com/ryomario/horeg-audio/issues"
  },
  "homepage": "https://github.com/ryomario/horeg-audio#readme",
  "type": "module",
  "main": "./dist/horeg-audio.cjs",
  "module": "./dist/horeg-audio.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/horeg-audio.global.js",
  "jsdelivr": "./dist/horeg-audio.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/horeg-audio.js",
      "require": "./dist/horeg-audio.cjs",
      "default": "./dist/horeg-audio.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "audio-player",
    "music-player",
    "sound-horeg",
    "typescript",
    "shadow-dom",
    "vanilla-js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.1"
  }
}
